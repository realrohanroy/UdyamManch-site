# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-17
SANITY_REVALIDATE_SECRET=your_secure_random_revalidation_secret

# Vercel Deployment Secrets (Configured in GitHub Repo Secrets for CI/CD)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# Public site address. Set per environment so canonicals, sitemap and share cards use the right host.
NEXT_PUBLIC_SITE_URL=https://udyammanch.com

# Newsletter: address of your mailing list's embed form (it receives an `email` field by POST).
# Leave empty and the forms say signups are not open yet, instead of pretending to subscribe.
NEXT_PUBLIC_NEWSLETTER_ACTION=

# Google Form for founder submissions (Get featured page and button).
NEXT_PUBLIC_FEATURE_FORM_URL=
